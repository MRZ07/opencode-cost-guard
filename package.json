{
  "name": "opencode-cost-guard",
  "version": "0.7.0",
  "description": "Cost guard plugin for opencode: warn or hard-stop a session when its LLM spend exceeds a configurable USD limit.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "files": ["index.js", "lib.js", "accounting.js", "index.d.ts", "dist", "README.md", "LICENSE", "test", "benchmark", "scripts/init-budget.mjs"],
  "scripts": {
    "test": "node test/smoke.mjs && node test/accounting.mjs && node test/init-budget.mjs",
    "init:budget": "node scripts/init-budget.mjs",
    "bench:journal": "node benchmark/journal-replay.mjs",
    "build:local": "node build-local.mjs"
  },
  "keywords": ["opencode", "opencode-plugin", "cost", "budget", "guard", "llm"],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
